%header.border-b.border-line.bg-panel.px-4.py-3
  .mx-auto.flex.max-w-screen-2xl.items-center.justify-between.gap-4
    %div
      %h1.text-base.font-semibold.tracking-tight.text-white Mobilis Browser Playground
      %p.text-xs.text-slate-400 CRuby/WASM · Prism · real Mobilis generators · no backend
    .flex.items-center.gap-2
      %span#runtime-status.rounded-full.border.border-teal-900.bg-teal-950.px-2.py-1.text-xs.text-teal-300 Local runtime ready
      %button#download-dsl.rounded.border.border-line.px-3.py-2.text-xs.text-slate-200.hover:bg-slate-800 Download DSL
      %button#download-authoring-bundle.rounded.border.border-line.px-3.py-2.text-xs.text-slate-200.hover:bg-slate-800 Local bundle
      %button#generate-button.rounded.bg-teal-300.px-3.py-2.text-xs.font-bold.text-slate-950.hover:bg-teal-200 Generate project

%section.mx-auto.grid.max-w-screen-2xl.gap-3.p-3.lg:grid-cols-2.xl:grid-cols-3
  #builder-region.min-h-96.rounded-lg.border.border-line.bg-panel
    != builder
  #editor-region.min-h-96.rounded-lg.border.border-line.bg-panel
    != editor
  #inspector-region.min-h-96.rounded-lg.border.border-line.bg-panel{class: "lg:col-span-2 xl:col-span-1"}
    != inspector

%section.mx-auto.max-w-screen-2xl.px-3.pb-3
  #architecture-region.rounded-lg.border.border-line.bg-panel
    != architecture

%section.mx-auto.grid.max-w-screen-2xl.gap-3.px-3.pb-3{class: "lg:grid-cols-[20rem_1fr]"}
  #files-region.rounded-lg.border.border-line.bg-panel
    != files
  #file-content-region.min-h-64.rounded-lg.border.border-line.bg-panel
    != file_content

#diagnostics-region.mx-auto.max-w-screen-2xl.px-3.pb-4
  != diagnostics

.flex.items-center.justify-between.border-b.border-line.px-3.py-2
  %div
    %h2.text-sm.font-semibold.text-white Service inspector
    %p.text-xs.text-slate-500 Validated configuration and source-owned relationships.
  %span.rounded.bg-slate-800.px-2.py-1.text-xs.text-slate-300= "#{services.length} services"
#service-inspector-panels.max-h-screen.overflow-auto
  - if services.empty?
    .p-6.text-center.text-xs.text-slate-500 Add a service to inspect its complete configuration.
  - services.each do |service|
    .service-inspector.hidden.space-y-4.p-3{data: {inspector_id: service.id, source_id: service.declaration&.id}}
      .flex.items-start.justify-between.gap-3
        %div
          %p.uppercase.tracking-wide.text-teal-300{class: "text-[10px]"}= service.type
          %h3.text-base.font-semibold.text-white= service.name
        - if service.declaration
          %button.focus-source.rounded.border.border-line.px-2.py-1.text-xs.text-slate-300.hover:bg-slate-800{type: "button", data: {start_offset: service.declaration.start_offset, end_offset: service.declaration.end_offset}} View Ruby
        - else
          %span.rounded.bg-amber-950.px-2.py-1.text-amber-300{class: "text-[10px]"} Dynamic or nested source

      - if service.declaration && !service.editable_properties.empty?
        %section.space-y-2
          %h4.text-xs.font-semibold.text-white Editable declaration properties
          .grid.gap-2.sm:grid-cols-2
            - service.editable_properties.each do |property, details|
              - value = service.declaration.properties.fetch(property, details[:default])
              %label.text-slate-400{class: "text-[11px]"}
                %span.mb-1.block= property
                - if details[:kind] == :boolean
                  %input.inspector-service-property.h-4.w-4.accent-teal-300{type: "checkbox", checked: value == true, disabled: value == :dynamic, data: {property: property}}
                - else
                  %input.inspector-service-property.w-full.rounded.border.border-line.bg-slate-950.px-2.py-2.text-xs.text-white{value: value.is_a?(Array) ? value.join(", ") : value, disabled: value == :dynamic, data: {property: property}}

      %section.space-y-2
        .flex.items-center.justify-between
          %h4.text-xs.font-semibold.text-white Semantic outgoing connections
          %span.text-slate-500{class: "text-[10px]"} Owned by this service's Ruby calls
        - if service.outgoing.empty?
          %p.rounded.border.border-dashed.border-line.p-3.text-xs.text-slate-500 No direct connect/route declarations.
        - service.outgoing.each do |relationship|
          .relationship-editor.space-y-2.rounded.border.border-line.bg-slate-950.p-2{data: {relationship_id: relationship.id}}
            .grid.gap-2{class: "grid-cols-[7rem_1fr_auto]"}
              %select.relationship-kind.rounded.border.border-line.bg-panel.px-2.py-1.text-xs
                - %i[connect route].each do |kind|
                  %option{value: kind, selected: relationship.kind == kind}= kind
              %select.relationship-target.rounded.border.border-line.bg-panel.px-2.py-1.text-xs
                - services.reject { |candidate| candidate.name == service.name }.each do |candidate|
                  %option{value: candidate.name, selected: candidate.name == relationship.to}= candidate.name
              %button.remove-relationship.rounded.border.border-red-950.px-2.py-1.text-xs.text-red-300.hover:bg-red-950{type: "button"} Remove
            - if relationship.kind == :connect
              .grid.gap-2.sm:grid-cols-2
                %label.text-slate-400{class: "text-[10px]"}
                  %span.block Skip health checks
                  %input.relationship-property.h-4.w-4.accent-teal-300{type: "checkbox", checked: relationship.properties[:force_skip_health_checks] == true, data: {property: "force_skip_health_checks"}}
                - %i[publish subscribe].each do |property|
                  %label.text-slate-400{class: "text-[10px]"}
                    %span.block= "#{property} role (name or JSON)"
                    - role_value = relationship.properties[property]
                    %input.relationship-property.w-full.rounded.border.border-line.bg-panel.px-2.py-1.text-xs.text-white{value: role_value.is_a?(String) ? role_value : (role_value == :dynamic ? "dynamic expression" : role_value&.to_json), disabled: role_value == :dynamic, data: {property: property}}
            - else
              .grid.gap-2.sm:grid-cols-2
                - %i[candidate shadow].each do |property|
                  %label.text-slate-400{class: "text-[10px]"}
                    %span.block= property
                    %select.relationship-property.w-full.rounded.border.border-line.bg-panel.px-2.py-1.text-xs{data: {property: property}}
                      %option{value: ""} none
                      - services.reject { |candidate| candidate.name == service.name }.each do |candidate|
                        %option{value: candidate.name, selected: candidate.name == relationship.properties[property]}= candidate.name
                - %i[mirror_percent candidate_percent].each do |property|
                  %label.text-slate-400{class: "text-[10px]"}
                    %span.block= property
                    %input.relationship-property.w-full.rounded.border.border-line.bg-panel.px-2.py-1.text-xs.text-white{type: "number", min: 0, max: 100, value: relationship.properties.fetch(property, 0), data: {property: property}}
            %button.focus-source.text-xs.text-teal-300.hover:text-teal-200{type: "button", data: {start_offset: relationship.start_offset, end_offset: relationship.end_offset}} Focus relationship source

        - if services.length > 1
          .new-relationship.grid.gap-2.rounded.border.border-dashed.border-line.p-2{class: "grid-cols-[7rem_1fr_auto]", data: {from: service.name}}
            %select.new-relationship-kind.rounded.border.border-line.bg-slate-950.px-2.py-1.text-xs
              %option{value: "connect"} connect
              %option{value: "route"} route
            %select.new-relationship-target.rounded.border.border-line.bg-slate-950.px-2.py-1.text-xs
              - services.reject { |candidate| candidate.name == service.name }.each do |candidate|
                %option{value: candidate.name}= candidate.name
            %button.add-relationship.rounded.border.border-teal-900.px-2.py-1.text-xs.text-teal-300.hover:bg-teal-950{type: "button"} Add

      %section.space-y-2
        %h4.text-xs.font-semibold.text-white Incoming semantic connections
        - if service.incoming.empty?
          %p.text-xs.text-slate-500 None.
        - service.incoming.each do |relationship|
          .flex.items-center.justify-between.rounded.bg-slate-950.px-2.py-2.text-xs
            %span= "#{relationship.from} → #{service.name} (#{relationship.kind})"
            %button.focus-source.text-teal-300.hover:text-teal-200{type: "button", data: {start_offset: relationship.start_offset, end_offset: relationship.end_offset}} Owned by #{relationship.from}

      %section.space-y-2
        %h4.text-xs.font-semibold.text-white Operational dependencies
        %p.text-slate-500{class: "text-[10px]"} Realized dependency behavior; distinct from semantic connection ownership.
        - if service.dependencies.empty? && service.references.empty?
          %p.text-xs.text-slate-500 None.
        - service.references.each do |dependency|
          .rounded.bg-blue-950.px-2.py-1.text-xs.text-blue-200= "Reference #{dependency.kind}: #{dependency.target}"
        - service.dependencies.each do |dependency|
          .rounded.bg-slate-950.px-2.py-1.text-xs.text-slate-300= "depends_on #{dependency.target}#{dependency.relationship ? " via #{dependency.relationship}" : ""}"

      %details.rounded.border.border-line.bg-slate-950
        %summary.cursor-pointer.px-3.py-2.text-xs.text-slate-300 Complete validated configuration
        %pre.max-h-80.overflow-auto.whitespace-pre-wrap.border-t.border-line.p-3.text-slate-400{class: "text-[10px]"}= service.configuration

.border-t.border-line
  .flex.items-center.justify-between.px-3.py-2
    %div
      %h3.text-xs.font-semibold.text-white Embedded documents
      %p.text-slate-500{class: "text-[10px]"} Browse and stage text edits without invoking Ruby.
    %span.rounded.bg-slate-800.px-2.py-1.text-slate-300{class: "text-[10px]"}= "#{documents.archives.length} archives"
  #embedded-archive-browser.space-y-2.p-3.pt-0
    - if documents.archives.empty?
      %p.rounded.border.border-dashed.border-line.p-3.text-xs.text-slate-500 No literal embedded_archive declarations in the validated source.
    - documents.archives.each do |archive_document|
      - declaration = archives.find { |candidate| candidate.id == archive_document.id }
      %details.embedded-archive.rounded.border.border-line.bg-slate-950{data: {archive_id: archive_document.id}}
        %summary.cursor-pointer.px-3.py-2.text-xs.text-slate-200
          = archive_document.name
          %span.ml-2.text-slate-500= "#{documents.members(archive_document.id).length} files"
        .space-y-1.border-t.border-line.p-2
          - documents.members(archive_document.id).each do |member|
            %button.open-embedded-member.flex.w-full.items-center.justify-between.rounded.px-2.py-2.text-left.text-xs.hover:bg-slate-800{type: "button", disabled: !member.editable, data: {document_id: member.id, archive_id: member.archive_id, path: member.path, content_type: member.content_type, content_base64: member.content_base64, parent_revision: member.parent_revision}}
              %span.truncate= member.path
              %span.text-slate-500{class: "text-[10px]"}= member.editable ? "text" : "binary"
          - if declaration
            %button.focus-source.mt-1.text-xs.text-teal-300.hover:text-teal-200{type: "button", data: {start_offset: declaration.start_offset, end_offset: declaration.end_offset}} Focus archive declaration

#!/usr/bin/env bash
set -euo pipefail

playground_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
repository_dir="$(cd "${playground_dir}/.." && pwd)"

cd "${playground_dir}"
mkdir -p public/vendor/ruby-wasm-wasi public/vendor/wasi public/vendor/zip public/vendor/mermaid/chunks public/vendor/buffer public/vendor/isomorphic-git public/vendor/lightning-fs public/parity

npm run build:css
npx esbuild assets/buffer-polyfill.js --bundle --minify --platform=browser --format=iife --outfile=public/vendor/buffer/buffer.min.js
cp node_modules/buffer/LICENSE public/vendor/buffer/
cp node_modules/@hotwired/turbo/dist/turbo.es2017-esm.js public/vendor/
cp node_modules/@ruby/wasm-wasi/dist/browser.umd.js public/vendor/ruby-wasm-wasi.umd.js
cp -R node_modules/@ruby/wasm-wasi/dist/esm/. public/vendor/ruby-wasm-wasi/
cp -R node_modules/@bjorn3/browser_wasi_shim/dist/. public/vendor/wasi/
cp -R node_modules/@zip.js/zip.js/. public/vendor/zip/
cp node_modules/mermaid/dist/mermaid.esm.min.mjs public/vendor/mermaid/
cp -R node_modules/mermaid/dist/chunks/mermaid.esm.min public/vendor/mermaid/chunks/
cp node_modules/isomorphic-git/index.umd.min.js public/vendor/isomorphic-git/
cp node_modules/isomorphic-git/LICENSE.md public/vendor/isomorphic-git/
cp node_modules/@isomorphic-git/lightning-fs/dist/lightning-fs.min.js public/vendor/lightning-fs/
cp node_modules/@isomorphic-git/lightning-fs/LICENSE public/vendor/lightning-fs/
cp "${repository_dir}/spec/fixtures/browser/postgres-compose.yml" public/parity/
ruby scripts/build_embedded_fixture.rb public/parity/embedded-source.rb
ruby scripts/build_examples.rb "${repository_dir}/scripts" public/examples
# Load the exact pinned Carbn browser Git and workspace engine.
carbn_browser="${CARBN_LIB_DIR:-}/../browser"
if [[ ! -f "${carbn_browser}/workspace-history.js" || ! -f "${carbn_browser}/git-capability.js" || ! -f "${carbn_browser}/working-tree.js" ]]; then
  echo "Pinned Carbn browser Git modules are missing" >&2
  exit 1
fi
# Do not ship obsolete Diesl/legacy Git assets from a prior local build.
rm -rf public/diesl
rm -f public/git-capability.js
mkdir -p public/carbn
cp "${carbn_browser}/workspace-history.js" "${carbn_browser}/git-capability.js" "${carbn_browser}/working-tree.js" public/carbn/
# Verify Carbn workspace history/rollback before packaging the browser.
node --test "${CARBN_LIB_DIR}/../test/workspace-history.test.mjs"

runtime_path="${RUBY_WASM_RUNTIME_SOURCE:-node_modules/@ruby/4.0-wasm-wasi/dist/ruby+stdlib.wasm}"
if [[ ! -f "${runtime_path}" ]]; then
  echo "Ruby WASM runtime not found: ${runtime_path}" >&2
  exit 1
fi
rm -f public/mobilis.wasm public/filesystem.json
# Immutable URLs must identify immutable bytes. A stable /vendor/*.wasm path
# previously allowed force-cache to reuse an older runtime after a rebuild;
# the browser then rejected its stale body against the new SRI digest.
if [[ "${COPY_LOCAL_RUBY_WASM:-0}" == "1" ]]; then
  runtime_sha256="$(sha256sum "${runtime_path}" | cut -d' ' -f1)"
  runtime_url="/vendor/ruby-${runtime_sha256}.wasm"
  mkdir -p public/vendor
  cp "${runtime_path}" "public${runtime_url}"
  test -s "public${runtime_url}"
  export RUBY_WASM_RUNTIME_URL="${runtime_url}"
fi
ruby scripts/build_runtime_config.rb "${runtime_path}" public/runtime-config.json

haml_path="$(BUNDLE_GEMFILE="${playground_dir}/Gemfile" bundle show haml)"
temple_path="$(BUNDLE_GEMFILE="${playground_dir}/Gemfile" bundle show temple)"
thor_path="$(BUNDLE_GEMFILE="${playground_dir}/Gemfile" bundle show thor)"
tilt_path="$(BUNDLE_GEMFILE="${playground_dir}/Gemfile" bundle show tilt)"
staging_dir="$(mktemp -d)"
trap 'rm -rf "${staging_dir}"' EXIT
mkdir -p "${staging_dir}/src/playground" "${staging_dir}/src/generator_compatibility" "${staging_dir}/gems"
cp -R "${repository_dir}/lib" "${staging_dir}/src/lib"
# Diesl and Carbn execute as ordinary pure-Ruby sources in the WASM app.
# Build inputs must explicitly provide exact, pinned checkouts.
diesl_lib="${DIESL_LIB_DIR:-}"
carbn_lib="${CARBN_LIB_DIR:-}"
if [[ ! -f "${diesl_lib}/diesl.rb" || ! -f "${carbn_lib}/carbn.rb" ]]; then
  echo "Diesl and Carbn source paths required: set DIESL_LIB_DIR and CARBN_LIB_DIR" >&2
  exit 1
fi
cp -R "${diesl_lib}/." "${staging_dir}/src/lib/"
cp -R "${carbn_lib}/." "${staging_dir}/src/lib/"
# Serialize the *actual* Diesl workspace block as a browser ESM module.
# This removes duplicate path, Git author and generated-root configuration.
ruby -I"${repository_dir}/lib" -I"${diesl_lib}" -rjson -rdiesl -rmobilis/browser/workspace_policy -e '
  codec = Class.new do
    def self.unpack(_payload) = nil
    def self.replace(_payload, _path, _content) = nil
  end
  manifest = Mobilis::Browser::WorkspacePolicy.manifest(codec:)
  abort "Expected exactly one generated root" unless manifest.fetch(:generated).length == 1
  abort "Expected Git policy" unless manifest.fetch(:git)
  File.write(ARGV.fetch(0), "export const workspacePolicy = Object.freeze(" + JSON.generate(manifest) + ");")
' public/editor-policy.js
cp -R "${repository_dir}/generator_compatibility/captures" "${staging_dir}/src/generator_compatibility/captures"
cp -R "${playground_dir}/app" "${staging_dir}/src/playground/app"
cp -R "${playground_dir}/templates" "${staging_dir}/src/playground/templates"
cp -R "${haml_path}/lib" "${staging_dir}/gems/haml"
cp -R "${temple_path}/lib" "${staging_dir}/gems/temple"
cp -R "${thor_path}/lib" "${staging_dir}/gems/thor"
cp -R "${tilt_path}/lib" "${staging_dir}/gems/tilt"
ruby scripts/build_application.rb "${staging_dir}" public
ruby -rjson -e '
  manifest = JSON.parse(File.read(ARGV.fetch(0)))
  paths = manifest.fetch("filesystem").fetch("files").map { |entry| entry.fetch("path") }
  %w[src/lib/diesl.rb src/lib/carbn.rb src/lib/mobilis/browser/diesl_editor.rb].each do |path|
    abort "Browser application is missing required library: #{path}" unless paths.include?(path)
  end
' public/mobilis-app-manifest.json
ruby scripts/verify_runtime_compatibility.rb public/runtime-config.json public/mobilis-app-manifest.json

#!/usr/bin/env ruby
# frozen_string_literal: true

require "pathname"
require "prism"
$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))
require_relative "../lib/mobilis"

class DemoScriptCompiler
  GENERATED_NOTICE = "# Generated by scripts/build_scripts; edit the directory-local source instead.\n"

  def initialize(root: Pathname(__dir__), check: false)
    @root = root
    @check = check
  end

  def call
    sources = root.children.select(&:directory?).sort.filter_map do |directory|
      source = directory.join("#{directory.basename}.rb")
      source if source.file?
    end
    raise "No numbered directory-local demo scripts found" if sources.empty?

    sources.each { |source| compile(source) }
    puts "#{check ? "Verified" : "Built"} #{sources.length} self-contained demo scripts"
  end

  private

  attr_reader :root, :check

  def compile(source_path)
    source = source_path.binread
    result = Prism.parse(source)
    unless result.success?
      errors = result.errors.map { |error| "#{error.message} at line #{error.location.start_line}" }
      raise "#{source_path}: #{errors.join(", ")}"
    end

    calls = prism_nodes(result.value).select do |node|
      node.is_a?(Prism::CallNode) && node.name == :pack && node.receiver&.slice == "Mobilis::EmbeddedArchive"
    end
    raise "#{source_path}: no Mobilis::EmbeddedArchive.pack calls found" if calls.empty?

    assert_all_sidecars_referenced!(source_path, source)
    compiled = calls.sort_by { |node| -node.location.start_offset }.reduce(source) do |text, node|
      payload = eval(node.slice, TOPLEVEL_BINDING, source_path.to_s, node.location.start_line) # rubocop:disable Security/Eval
      unless payload.is_a?(String) && Mobilis::EmbeddedArchive.unpack(payload)
        raise "#{source_path}: archive expression did not produce a valid payload"
      end

      replace_bytes(text, node.location.start_offset, node.location.end_offset, payload.dump)
    end
    compiled = insert_notice(compiled)
    raise "#{source_path}: compiled output still reads authored sidecars" if compiled.include?("File.binread")

    output_path = root.join("#{source_path.dirname.basename}.rb")
    if check
      raise "#{output_path} is stale; run scripts/build_scripts" unless output_path.file? && output_path.binread == compiled
    else
      output_path.binwrite(compiled)
      output_path.chmod(source_path.stat.mode & 0o777)
    end
  end

  def assert_all_sidecars_referenced!(source_path, source)
    sidecars = source_path.dirname.glob("**/*", File::FNM_DOTMATCH).select(&:file?).reject { |path| path == source_path }
    missing = sidecars.reject do |path|
      relative = path.relative_path_from(source_path.dirname).to_s
      source.include?(relative.dump) || source.include?(%('#{relative}'))
    end
    raise "#{source_path}: unreferenced sidecars: #{missing.join(", ")}" unless missing.empty?
  end

  def prism_nodes(node, result = [])
    result << node
    node.compact_child_nodes.each { |child| prism_nodes(child, result) }
    result
  end

  def replace_bytes(source, start_offset, end_offset, replacement)
    source.byteslice(0, start_offset) + replacement + source.byteslice(end_offset, source.bytesize - end_offset).to_s
  end

  def insert_notice(source)
    first_line_end = source.index("\n")
    return GENERATED_NOTICE + source unless first_line_end && source.start_with?("#!")

    source.byteslice(0, first_line_end + 1) + GENERATED_NOTICE + source.byteslice(first_line_end + 1, source.bytesize).to_s
  end
end

DemoScriptCompiler.new(check: ARGV.delete("--check")).call if $PROGRAM_NAME == __FILE__

#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"
source ./demo-env
operation=$(basename "$0")
echo "Running $operation in $MOBILIS_ENV using $mobilis_dc"
run() { dc run --rm --no-deps -T legacy python /app/demo/operations.py "$@"; }
viewer() {
  local binding
  binding=$(dc port trace-viewer 16686 | tail -n 1)
  echo "Traces: http://localhost:${binding##*:}"
}
if [[ "$operation" == "verify" ]]; then
  state=$(run state | tail -n 1)
  restore=()
  cleanup() {
    if (( ${#restore[@]} )); then
      dc start "${restore[@]}" >/dev/null
      run ready "${restore[@]}" >/dev/null
    fi
  }
  trap cleanup EXIT
  if [[ "$state" == "0 100" ]]; then
    if dc ps --status running --services | grep -qx legacy; then restore+=(legacy); fi
    dc stop legacy >/dev/null
    echo "Verifying complete candidate cutover with legacy stopped"
    run verify
  else
    run verify
    if [[ "$state" == "100 0" ]]; then
      if dc ps --status running --services | grep -qx candidate; then restore+=(candidate); fi
      dc stop candidate >/dev/null
      echo "Verifying legacy authority with candidate stopped"
      run failure
      cleanup
      restore=()
      # Establish shadow evidence AFTER the deliberate failure-test restart.
      # This candidate process then continues unchanged through partial/cutover.
      echo "Verifying restored candidate shadowing with the same deployment"
      run verify
    fi
  fi
else
  run "$operation" "$@"
fi
viewer

#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"
operation=$(basename "$0")
run() { ./dc_test run --rm --no-deps -T legacy python /app/demo/operations.py "$@"; }
viewer() {
  local binding
  binding=$(./dc_test port trace-viewer 16686 | tail -n 1)
  echo "Traces: http://localhost:${binding##*:}"
}
if [[ "$operation" == "verify" ]]; then
  state=$(run state | tail -n 1)
  restore=()
  cleanup() {
    if (( ${#restore[@]} )); then
      ./dc_test start "${restore[@]}" >/dev/null
      run ready "${restore[@]}" >/dev/null
    fi
  }
  trap cleanup EXIT
  if [[ "$state" == "0 100" ]]; then
    if ./dc_test ps --status running --services | grep -qx legacy; then restore+=(legacy); fi
    ./dc_test stop legacy >/dev/null
    echo "Verifying complete candidate cutover with legacy stopped"
    run verify
  else
    run verify
    if [[ "$state" == "100 0" ]]; then
      for candidate_service in candidate candidate-shadow; do
        if ./dc_test ps --status running --services | grep -qx "$candidate_service"; then restore+=("$candidate_service"); fi
      done
      ./dc_test stop candidate candidate-shadow >/dev/null
      echo "Verifying legacy authority with both candidate instances stopped"
      run failure
    fi
  fi
else
  run "$operation" "$@"
fi
viewer

ARG RUBY_WASM_RUNTIME_IMAGE="mobilis-playground-ruby-runtime:2.10.1-ruby-4.0.10-rails-8.1.4.1-json-3.1.0-single-ext"
FROM ${RUBY_WASM_RUNTIME_IMAGE} AS ruby_runtime

FROM node:22.23.5-trixie AS node

FROM ruby:4.0.10-trixie AS build

COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
  && ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
  && node --version \
  && npm --version

WORKDIR /build
COPY playground/Gemfile playground/Gemfile.lock ./playground/
RUN ruby -rbundler -e 'abort "Expected Bundler 4.0.20, got #{Bundler::VERSION}" unless Bundler::VERSION == "4.0.20"'
RUN cd playground && bundle _4.0.20_ config set --local frozen true \
  && bundle _4.0.20_ install

COPY playground/package.json playground/package-lock.json ./playground/
RUN cd playground && npm ci

COPY lib ./lib
COPY generator_compatibility/captures ./generator_compatibility/captures
COPY spec/fixtures/browser ./spec/fixtures/browser
COPY playground ./playground
COPY --from=ruby_runtime /runtime/ruby+stdlib.wasm ./playground/runtime/ruby+stdlib.wasm
COPY --from=ruby_runtime /runtime/runtime.json ./playground/runtime/runtime.json
ARG RUBY_WASM_RUNTIME_PACKAGE="mobilis-ruby-wasm"
ARG RUBY_WASM_RUNTIME_VERSION="2.10.1-ruby-4.0.10-rails-8.1.4.1-json-3.1.0-single-ext"
ARG MOBILIS_APPLICATION_MANIFEST_URL="/mobilis-app-manifest.json"
RUN RUBY_WASM_RUNTIME_PACKAGE="${RUBY_WASM_RUNTIME_PACKAGE}" \
  RUBY_WASM_RUNTIME_VERSION="${RUBY_WASM_RUNTIME_VERSION}" \
  RUBY_WASM_RUNTIME_SOURCE="runtime/ruby+stdlib.wasm" \
  COPY_LOCAL_RUBY_WASM=1 \
  MOBILIS_APPLICATION_MANIFEST_URL="${MOBILIS_APPLICATION_MANIFEST_URL}" \
  playground/scripts/build

FROM nginx:1.30.6-trixie

COPY playground/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /build/playground/public /usr/share/nginx/html

EXPOSE 80

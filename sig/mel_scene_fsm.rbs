module Mel
  class SceneFSM
    def prompt: () -> TTY::Prompt
    def blank_space: () -> void
    def ask_prompt: (Array[Hash[Symbol, untyped]]) -> untyped
    def choices_per_page: () -> Integer
    def visit_submachine: (Mel::SceneFSM) -> void

    def choices: () -> untyped
    def display: () -> untyped
    def action: () -> untyped
    def spacer: () -> untyped

    def still_running?: () -> bool
    def choose_destination: () -> (void | false)
    def decobox: (*Array[String]) -> void
    def state: (Symbol) { () -> void } -> void
    def any: () -> untyped
    def event: (Symbol) { () -> void } -> void
    def transition: (Hash[Symbol | Array[Symbol] | :any, Symbol]) -> void
  end
end


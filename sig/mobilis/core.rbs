module Git
  def self.init: (String path) -> untyped
end

module Mobilis
  class System
    attr_reader config_nodes: Hash[String, Mobilis::Base::Node]
    attr_reader meta_project_name: String
    attr_reader starting_port: Integer
    attr_accessor kubernetes_deployment: Mobilis::Kubernetes::Declaration?

    def initialize: (String meta_project_name, ?starting_port: Integer) -> void
    def <<: (Mobilis::Base::Node config_node) -> Mobilis::Base::Node
    def []: (String id) -> Mobilis::Base::Node?
    def each_config_node: () { (Mobilis::Base::Node config_node) -> void } -> Array[Mobilis::Base::Node]
                        | () -> Enumerator[Mobilis::Base::Node, void]
    def resolve!: () -> Hash[String, Mobilis::Base::Node]
    def to_h: () -> Mobilis::system_record
    def to_json: (*Object args) -> String
    def node_count: () -> Integer
    def ppx_fields: (untyped dsl) -> untyped

    def self.from_h: (Mobilis::system_record hash) -> Mobilis::System
    def self.from_json: (String json) -> Mobilis::System
  end

  class ExecutionEnvironment
    attr_reader value: Symbol
    def initialize: (Symbol | String value) -> void
    def is_dev?: () -> bool
    def is_test?: () -> bool
    def is_production?: () -> bool
    def is_staging?: () -> bool
    def to_s: () -> String
    def ppx_fields: (untyped dsl) -> untyped
  end

  class NoSuchNode < StandardError
  end

  class RealizedEnv
    class PortAllocator
      def initialize: (Integer starting_port, ?reservation_count: Integer) -> void
      def reserve: (?preferred_port: Integer?, ?allocation_key: String?) -> Integer
    end
    attr_reader system: Mobilis::System
    attr_reader environment: Mobilis::ExecutionEnvironment
    attr_reader realized_nodes: Array[Mobilis::Base::RealizedNode]

    def initialize: (Mobilis::System system, Mobilis::ExecutionEnvironment environment, ?port_allocator: PortAllocator?) -> void
    def reserve_external_port: (?preferred_port: Integer?, ?allocation_key: String?) -> Integer
    def to_s: () -> String
    def <<: (Mobilis::Base::RealizedNode realized_node) -> Array[Mobilis::Base::RealizedNode]
    def realized_node_for_config_node: (Mobilis::Base::Node system_node) -> Mobilis::Base::RealizedNode?
    def realized_node_by_name: (String name) -> Mobilis::Base::RealizedNode
    def find_realized_node_by_name: (String name) -> Mobilis::Base::RealizedNode?
    def ppx_fields: (untyped dsl) -> untyped
    def required_plugins: () -> Array[singleton(Mobilis::Base::Plugin)]
    def each_node_of_type: (singleton(Object) klass) { (Mobilis::RealizedEnv env, Mobilis::Base::RealizedNode node) -> untyped } -> untyped
                         | (singleton(Object) klass) -> Enumerator[untyped, untyped]
    def each_node: () { (Mobilis::Base::RealizedNode node) -> untyped } -> untyped
                 | () -> Enumerator[Mobilis::Base::RealizedNode, untyped]
    def all_envfile_vars: () { (Mobilis::Primitives::EmitVar emit_var) -> untyped } -> untyped
                        | () -> Enumerator[Mobilis::Primitives::EmitVar, untyped]
    def meta_project_name: () -> String
    def is_production?: () -> bool
    def is_development?: () -> bool
    def is_test?: () -> bool

    private

    def build_all_nodes!: () -> Array[Mobilis::Base::RealizedNode]
    def build_realized_node: (Mobilis::Base::Node config_node) -> Mobilis::Base::RealizedNode?
  end

  class Manifest
    attr_reader system: Mobilis::System
    attr_reader realized_envs: Array[Mobilis::RealizedEnv]
    attr_reader directory_service: Mobilis::Services::Directory
    attr_reader git_repo: untyped
    attr_reader plugins: Array[Mobilis::Base::Plugin | Mobilis::Base::RealizedNodePlugin]

    def initialize: (Mobilis::System system, ?suppress_plugins: bool, ?directory_service: Mobilis::Services::Directory) -> void
    def git_repo=: (untyped repo) -> untyped
    def materialize_browser: (on_checkpoint: ^(String, Hash[String, String], Array[String]) -> untyped) -> String
    def materialize_static: () -> String
    def run_generation: (Mobilis::Generation::Execution execution) -> String
    def kubernetes_universes: () -> Array[Mobilis::Kubernetes::Universe]
    def write_kubernetes: () -> untyped
    def kubernetes_readme_section: () -> String
    def add_plugin: (Mobilis::Base::Plugin | Mobilis::Base::RealizedNodePlugin plugin) -> Array[Mobilis::Base::Plugin | Mobilis::Base::RealizedNodePlugin]
    def realized_production_env: () -> Mobilis::RealizedEnv
    def realized_env: (Symbol | String | Mobilis::ExecutionEnvironment target_env) -> Mobilis::RealizedEnv
    def materialize: () -> untyped
    def write_mobilis_system: () -> void
    def write_commands_file: () -> void
    def write_dc_helpers: () -> void
    def write_devcontainer: () -> bool
    def devcontainer_rails_services: () -> Array[Mobilis::Realized::Rails]
    def devcontainer_config: (Mobilis::Realized::Rails service, String env, ?nested: bool) -> Hash[String, untyped]
    def devcontainer_initialize_command: (String env) -> String
    def devcontainer_compose_files: (String env, nested: bool) -> Array[String]
    def devcontainer_overrides: (Array[Mobilis::Realized::Rails] services) -> Hash[String, untyped]
    def devcontainer_customizations: () -> Hash[String, untyped]
    def write_dc_helper: (String filename, String env_name) -> void
    def write_gitignore: () -> void
    def write_readme: () -> void
    def grafana_readme_section: () -> String
    def pgadmin_readme_section: () -> String
    def commit_all: (String message) -> untyped
    def setup_plugins: () -> Array[Mobilis::Base::Plugin | Mobilis::Base::RealizedNodePlugin]
    def run_plugin_hooks: (Symbol hook) -> Array[Mobilis::Base::Plugin | Mobilis::Base::RealizedNodePlugin]
    def run_node_hooks: (Symbol hook) { (Mobilis::Base::RealizedNode node) -> untyped } -> untyped
                      | (Symbol hook) -> untyped
    def plugin_for: (singleton(Object) klass) -> (Mobilis::Base::Plugin | Mobilis::Base::RealizedNodePlugin)?
    def each_node_of_type: (singleton(Mobilis::Realized::Rails) klass) { (Mobilis::RealizedEnv env, Mobilis::Realized::Rails node) -> untyped } -> untyped
                         | (singleton(Object) klass) { (Mobilis::RealizedEnv env, Mobilis::Base::RealizedNode node) -> untyped } -> untyped
                         | (singleton(Object) klass) -> Enumerator[untyped, untyped]
    def ppx_fields: (untyped dsl) -> untyped
    def username: () -> String
    def overrides_for: (Mobilis::RealizedEnv realized_env) -> untyped

    private

    def environments: () -> Array[Mobilis::ExecutionEnvironment]
    def emit_env_files: () -> untyped
    def emit_compose_wrappers: () -> untyped
    def emit_all_services: () -> untyped
    def write_overrides_for: (Symbol raw_env) -> untyped
  end
end

module Mobilis::Project
  class MySQLInstance < GenericProject
    def generate: (directory_service: Mobilis::Services::Directory) -> void
    def child_env_vars: () -> Array[untyped]
    def env_vars: () -> Array[String]
    def env_name: () -> String
    def data_dir: () -> String
    def has_local_build: () -> bool
    def url: () -> String
    def username: () -> String
    def password: () -> String
    def is_datastore_project?: () -> bool
    def _empty_vars: () -> Array[String]
  end
end


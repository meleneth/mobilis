module Mobilis
  module Plugin
    class EnvVars < Mobilis::Base::Plugin
      def hook_before_services_written: () -> untyped

      private

      def suppress_matching_dependency_url: (Mobilis::Base::RealizedNode realized_node, String envfile_name) -> untyped
    end
    class FilteredActiveResource < Mobilis::Base::Plugin
      def hook_after_services_written: () -> untyped
      def hook_after_rails_models_created: () -> untyped

      private

      def write_provider_files: (Mobilis::Realized::Rails realized_node) -> untyped
      def write_consumer_files: (Mobilis::Realized::Rails realized_node) -> untyped
      def install_active_resource_gem: () -> untyped
      def patch_provider_models: (Mobilis::Realized::Rails realized_node) -> untyped
      def api_resources: (Mobilis::Realized::Rails realized_node) -> Array[Mobilis::Model::Rails::Model]
      def connected_rails_providers: (Mobilis::Realized::Rails realized_node) -> Array[Mobilis::Realized::Rails]
      def write_filterable_concern: () -> untyped
      def write_provider_controller: (Mobilis::Model::Rails::Model resource) -> untyped
      def add_provider_route: (Mobilis::Model::Rails::Model resource) -> untyped
      def patch_provider_model: (Mobilis::Model::Rails::Model resource) -> untyped
      def write_active_resource_client: (Mobilis::Realized::Rails provider, Mobilis::Model::Rails::Model resource) -> untyped
      def dependency_url_container_name: (Mobilis::Realized::Rails provider) -> String
      def permit_filter_args: (Mobilis::Model::Rails::Model resource) -> String
      def singular_name: (Mobilis::Model::Rails::Model resource) -> String
      def resources_name: (Mobilis::Model::Rails::Model resource) -> String
      def model_class_name: (Mobilis::Model::Rails::Model resource) -> String
      def controller_class_name: (Mobilis::Model::Rails::Model resource) -> String
    end
    class Plugerator < Mobilis::Base::Plugin
      def generate_per_node_plugins: () -> untyped
      def generate_plugins_for: (singleton(Mobilis::Base::RealizedNode) target_realized_node_class, singleton(Mobilis::Base::RealizedNodePlugin) target_plugin_class, untyped node_matcher) -> untyped
    end

    class GraphQLRailsIntegration < Mobilis::Base::RealizedNodePlugin
      def realized_node: () -> Mobilis::Realized::Rails
      def rails_builder: () -> Mobilis::Plugin::RailsBuilder
      def hook_after_services_written: () -> untyped
      def hook_after_rails_models_created: () -> untyped

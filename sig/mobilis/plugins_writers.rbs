  module ServiceWriter
    class Alloy < Mobilis::Base::ServiceWriter
      def realized_node: () -> Mobilis::Realized::Alloy
      def write: () -> untyped
      def config: () -> String
      def generated_project_regex: () -> String
      def loki_name: () -> String
    end
    class Flask < Mobilis::Base::ServiceWriter
      def realized_node: () -> Mobilis::Realized::Flask
      def write: () -> untyped
      def write_Dockerfile: () -> untyped
      def write_requirements_txt: () -> untyped
      def write_app_py: () -> untyped
      def write_compose_file: () -> untyped
    end
    class GoAws < Mobilis::Base::ServiceWriter
      def realized_node: () -> Mobilis::Realized::GoAws
      def write: () -> untyped

      private

      def service_dir: () -> String
      def goaws_yaml: () -> Mobilis::AutoVivify
      def cfg: () -> untyped
      def cfg_get: (String key, ?untyped default) -> untyped
      def region: () -> untyped
      def account_id: () -> untyped
      def log_to_file: () -> untyped
      def enable_duplicates: () -> untyped
      def queues: () -> Array[untyped]
      def topics: () -> Array[Hash[String, untyped]]
      def subscriptions_by_topic: () -> Hash[String, Array[Hash[String, untyped]]]
      def fetch_subscription_value: (untyped subscription, String key) -> untyped
      def normalize_topic_hash: (Hash[untyped, untyped] h) -> Hash[String, untyped]
    end
    class Grafana < Mobilis::Base::ServiceWriter
      def datasources: () -> Mobilis::AutoVivify
      def dashboard_provider: () -> Hash[Symbol, untyped]
      def dashboards: () -> Hash[String, Hash[Symbol, untyped]]
      def write: () -> untyped

      private

      def datasource_nodes: () -> Array[Mobilis::Base::RealizedNode]
      def datasource_for: (Mobilis::Base::RealizedNode node) -> Hash[Symbol, untyped]
      def prometheus_datasource: (Mobilis::Realized::Prometheus node) -> Hash[Symbol, untyped]
      def loki_datasource: (Mobilis::Realized::Loki node) -> Hash[Symbol, untyped]
      def jaeger_datasource: (Mobilis::Realized::Jaeger node) -> Hash[Symbol, untyped]
      def postgres_datasource: (Mobilis::Realized::PostgreSQL node) -> Hash[Symbol, untyped]
      def mysql_datasource: (Mobilis::Realized::MySQL node) -> Hash[Symbol, untyped]
      def overview_dashboard: () -> Hash[Symbol, untyped]
      def filtered_active_resource_dashboard: () -> Hash[Symbol, untyped]
      def service_log_panels: () -> Array[Hash[Symbol, untyped]]
      def s3_storage_panels: () -> Array[Hash[Symbol, untyped]]
      def database_panels: () -> Array[Hash[Symbol, untyped]]
      def service_inventory_markdown: () -> String
      def filtered_resource_markdown: (Hash[Symbol, untyped] resource) -> String
      def filtered_resources: () -> Array[Hash[Symbol, untyped]]
      def rails_nodes: () -> Array[Mobilis::Realized::Rails]
      def database_nodes: () -> Array[Mobilis::Realized::PostgreSQL | Mobilis::Realized::MySQL]
      def s3_storage_nodes: () -> Array[Mobilis::Realized::S3Storage]
      def loggable_nodes: () -> Array[Mobilis::Base::RealizedNode]
      def rack_nodes: () -> Array[Mobilis::Realized::Rack]
      def prometheus_datasource?: () -> bool
      def loki_datasource?: () -> bool
      def datasource_uid: (Mobilis::Base::RealizedNode node, String suffix) -> String
      def dashboard: (String uid, String title, Array[Hash[Symbol, untyped]] panels, Array[String] tags) -> Hash[Symbol, untyped]
      def markdown_panel: (Integer id, String title, String markdown, Integer x, Integer y, Integer w, Integer h) -> Hash[Symbol, untyped]
      def logs_panel: (Integer id, String title, String expr, Integer x, Integer y) -> Hash[Symbol, untyped]
      def timeseries_panel: (Integer id, String title, String expr, Integer x, Integer y) -> Hash[Symbol, untyped]
    end

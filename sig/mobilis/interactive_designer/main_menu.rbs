module Mobilis::InteractiveDesigner
  class MainMenu < Mobilis::SceneFSM
    attr_accessor project: Mobilis::Project::MetaProject
    attr_accessor selected_rails_project: Mobilis::Project::RailsProject

    def select_rails_project_for_editing: (Mobilis::Project::RailsProject) -> void
    def new_relic_license_key: () -> (String | false)
    def fancy_tp: (Array[untyped], *untyped) -> void
    def reload!: (?bool) -> true

    def self.state: (Symbol, untyped) -> void
    def self.event: (Symbol, untyped) -> void
    def self.transition: (untyped) -> void
    def self.after_transition: (untyped) -> void
  end
end


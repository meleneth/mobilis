module Mobilis
  module OutputFiles
    class Env < Mobilis::OutputFile
      attr_reader metaproject: Mobilis::Project::MetaProject
      attr_reader environment: String

      def initialize: (String, Mobilis::Project::MetaProject, Proc[void, Integer]) -> void

      def runasuser: () -> String

      def render: () -> String
    end
  end
end

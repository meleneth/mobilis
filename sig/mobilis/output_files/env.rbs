module Mobilis
  module OutputFiles
    class Env < Mobilis::OutputFile
      extend Forwardable

      attr_reader metaproject: Mobilis::Project::MetaProject
      attr_reader environment: Mobilis::ExecutionEnvironment

      def initialize: ( Mobilis::ExecutionEnvironment, Mobilis::Project::MetaProject) -> void
      def runasuser: () -> String
      def render: () -> String
      def next_auto_port_no: () -> Integer
    end
  end
end

# Represents a generic project with configuration and generation methods
module Mobilis
  class GenericProject
    attr_reader project_name: String
    attr_reader environment: String
    attr_reader config: untyped # Replace with a structured type if available

    def initialize: (project_name: String, environment: String, config: untyped) -> void

    # Generates the output files for this project
    def generate_files: () -> Array[Mobilis::OutputFile]

    # Returns a hash representation of project config or metadata
    def to_h: () -> Hash[untyped, untyped]
  end
end

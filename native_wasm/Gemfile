# frozen_string_literal: true

source "https://rubygems.org"

# Build against the same ruby.wasm toolchain family as the playground.
gem "ruby_wasm", "2.10.1"
# RubyVM JavaScript host ABI. Without this, instantiateModule lacks
# canonical_abi_drop_rb-abi-value and throws inside FinalizationRegistry.
gem "js", "2.10.1"
# Ruby 4 no longer includes bigdecimal as a prebuilt WASI stdlib extension.
gem "bigdecimal", "4.1.3"
# Force the source-platform gem: precompiled Linux extension binaries are not WASI.
# Nokogiri source builds use mini_portile2 to compile vendored libxml2/libxslt.
gem "mini_portile2", "2.8.9"
gem "nokogiri", "1.19.7", force_ruby_platform: true

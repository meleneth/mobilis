# syntax=docker/dockerfile:1.7

FROM ruby:4.0.10-trixie AS build

ARG RUBY_WASM_RUBY_VERSION="4.0.10"
ARG RUBY_WASM_RUBY_URL="https://cache.ruby-lang.org/pub/ruby/4.0/ruby-4.0.10.tar.xz"
ARG RUBY_WASM_RUBY_SHA256="1537f7a6003c436546ecab6b48b6e7725a9af2328f45a8af7f42f41c5df90ab8"
ARG RUBY_WASM_RUBY_RELEASE="4.0.10"
ARG RUBY_WASM_VERSION="2.10.1"

RUN apt-get update \
  && apt-get install --yes --no-install-recommends \
  autoconf \
  bison \
  build-essential \
  ca-certificates \
  clang \
  cmake \
  curl \
  git \
  make \
  ninja-build \
  patch \
  pkg-config \
  python3 \
  xz-utils \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /runtime-build
COPY native_wasm/Gemfile native_wasm/Gemfile.lock ./native_wasm/
RUN ruby -rbundler -e 'abort "Expected Bundler 4.0.20, got #{Bundler::VERSION}" unless Bundler::VERSION == "4.0.20"'
RUN cd native_wasm && bundle _4.0.20_ config set --local frozen true \
  && bundle _4.0.20_ install
COPY native_wasm ./native_wasm

# Build the complete Ruby 4.0.10 WASI runtime and its native gem extensions.
# The JSON ABI change deliberately uses a fresh cache namespace so no old
# json parser/generator object or static archive can survive the rebuild.
RUN --mount=type=cache,id=mobilis-native-wasm-build-v5-json-single-ext,target=/runtime-build/native_wasm/build \
  mkdir -p /runtime \
  && SSL_CERT_FILE="$(if [ -f /etc/devastation/ca-certificates.crt ]; then printf %s /etc/devastation/ca-certificates.crt; else printf %s /usr/lib/ssl/cert.pem; fi)" \
    RUBY_WASM_RUBY_VERSION="${RUBY_WASM_RUBY_VERSION}" \
    RUBY_WASM_RUBY_URL="${RUBY_WASM_RUBY_URL}" \
    RUBY_WASM_RUBY_SHA256="${RUBY_WASM_RUBY_SHA256}" \
    native_wasm/bin/build build \
  && cp native_wasm/dist/ruby+stdlib.wasm /runtime/ruby+stdlib.wasm

RUN RUBY_WASM_VERSION="${RUBY_WASM_VERSION}" RUBY_WASM_RUBY_RELEASE="${RUBY_WASM_RUBY_RELEASE}" \
  ruby -rdigest -rjson -e 'path = "/runtime/ruby+stdlib.wasm"; bytes = File.binread(path); File.write("/runtime/runtime.json", JSON.generate({format: "mobilis-ruby-wasm-runtime", version: 1, ruby_wasm: ENV.fetch("RUBY_WASM_VERSION"), ruby: ENV.fetch("RUBY_WASM_RUBY_RELEASE"), size: bytes.bytesize, sha256: Digest::SHA256.hexdigest(bytes)}) + "\n")'

FROM scratch
COPY --from=build /runtime /runtime
